#include<bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin>>t;
    while(t--) {
        string s;
        cin>>s;
        int n = s.length();
        if(n%2) 
            cout<<"No
";
        else {
            for(int i=0; i<n/2; i++) {
                if(s[i]!=s[n/2 + i]) {
                    cout<<"No
";
                    break;
                } else {
                    if(i == (n/2 - 1))
                        cout<<"Yes
";
                }
            }
        }
    }
}