#include<bits/stdc++.h>
using namespace std;
 
int main() {
    int n, min=INT_MAX, max=INT_MIN, c=0;
    cin>>n;
    int arr[n];
    for(int i=0; i<n; i++) {
        cin>>arr[i];
        if(arr[i]< min) {
            c++;
            min=arr[i];
        }
        if(arr[i]>max) {
            c++;
            max = arr[i];
        }
    }
    cout<<c-2;
}