#include<iostream>
#include <string>
#include <set>
using namespace std;
 
int main() {
    ios::sync_with_stdio(0); cin.tie(0); cout.tie(0);
    int t;
    cin>>t;
    while(t--) {
        int n;
        cin>>n;
        string s;
        cin>>s;
        int k=0;
        for(int i=0; i<s.length(); i++) {
            if(s[i]>='A' && s[i]<='Z') {
                s[i]+=32;
            }
        }
        set<char> x;
        for(int i=0; i<n; i++)
            x.insert(s[i]);
        if(x.size()<4) {
            cout<<"No
";
        } else {
            for(int i=0; i<s.length(); i++) {
                if(s[i]!='m' && s[i]!='e' && s[i]!='o' && s[i]!='w') {
                    cout<<"No
";
                    k=1;
                    break;
                }
            }
            if(k==0) {
                for(int i=0; i<s.length()-1; i++) {
                    if(s[i]!=s[i+1]) {
                        if(s[i]=='m' && s[i+1]!='e') {
                            cout<<"No
";
                            break;
                        } else if(s[i]=='e' && s[i+1]!='o') {
                            cout<<"No
";
                            break;
                        } else if(s[i]=='o' && s[i+1]!='w') {
                            cout<<"No
";
                            break;
                        } else if(s[i]=='w' && s[i+1]!='w') {
                            cout<<"No
";
                            break;
                        }
                    }
                    if(i==n-2) 
                        cout<<"Yes
";
                }
            }
            
        }
    }
}