#include<bits/stdc++.h>
using namespace std;
 
int main() {
    int arr[4];
    int d=1;
    for(int i=0; i<4; i++) 
        cin>>arr[i];
    for(int i=0; i<3; i++) {
        for(int r=0; r<3-i; r++) {
            if(arr[r]>arr[r+1]) {
                int a;
                a=arr[r];
                arr[r]=arr[r+1];
                arr[r+1]=a;
            }
        }
    }
    for(int i=0; i<3; i++) {
        if(arr[i]!=arr[i+1])
            d++;
    }
    cout<<4-d;
}
 
 